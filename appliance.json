{
  "schema": "ores.desktop-appliance/v1",
  "product": "pony-expres",
  "channel": "candidate",
  "orchestrator": {
    "engine": "ores-compose",
    "config": ".ores-compose.yaml",
    "public_config": null,
    "source_role": "desktop-daemon",
    "shutdown_timeout_ms": 5000
  },
  "host": {
    "trust_model": "developer-owned-trusted-host",
    "daemon_listen": "127.0.0.1:8762",
    "public_origin": "http://127.0.0.1:8762",
    "requires_public_ip": false
  },
  "cloudflare": {
    "mode": "gated",
    "credentials_in_repo": false,
    "token_source": "file",
    "token_file_env": "POEX_CF_TUNNEL_TOKEN_FILE",
    "hostname_env": "POEX_CF_TUNNEL_HOSTNAME",
    "origin": "http://127.0.0.1:8762",
    "hostname_template": "<installation-id>.<configured-zone>",
    "ingress_paths": [
      "/v1/invoke"
    ],
    "public_ingress_ready": false,
    "origin_auth": "dedicated-remote-auth-required",
    "promotion_reason": "The daemon invoke endpoint currently uses the local desktop-control bearer; add a distinct remote-auth bridge before exposing it through Cloudflare Tunnel."
  },
  "update": {
    "mode": "exact-revision",
    "allow_mutable_latest": false
  },
  "promotion_gates": {
    "public_ingress_ready": false,
    "daemon_lockfile_committed": false,
    "common_layer_pinned": true,
    "common_layer_ci_verified": false
  },
  "common_layer": {
    "repository": "ORESoftware/ores-common-desktop-infra",
    "checkout_dir": "tmp/dev/ores-common-desktop-infra",
    "status": "pinned",
    "revision": "7bb4ed89ab4aa4a81c5e26e36b91f58d6313cc7c",
    "capabilities": [
      "consumer-validation",
      "loopback-policy",
      "secret-file-policy",
      "cloudflare-policy",
      "update-policy",
      "process-lifecycle",
      "health-readiness",
      "structured-logging"
    ]
  }
}
